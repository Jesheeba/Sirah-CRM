# Copy this file to .env.local and fill in your Supabase project values.
# Find them in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key (SERVER ONLY — never prefix with NEXT_PUBLIC_, never expose to the browser).
# Required for per-tenant integration secrets: server actions read/write the secret columns
# of `integration_settings` through this key, which bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------------
# Optional GLOBAL messaging fallbacks. Per-tenant credentials configured in-app under
# Settings -> Integrations take precedence; these are used only when a tenant has not
# configured its own. Leave blank to fall back to mailto:/wa.me link mode.
# ---------------------------------------------------------------------------------
# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# App-level webhook verification token (stays global — one Meta app serves all numbers).
WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------------------------
# Meta (Facebook/Instagram) Lead Ads — one Meta app serves ALL tenants. App ID/Secret
# are global; each tenant connects its own Page(s) via OAuth (tokens stored per tenant).
# OAuth redirect + webhook callback derive from NEXT_PUBLIC_APP_URL above:
#   redirect URI : ${NEXT_PUBLIC_APP_URL}/api/meta/oauth/callback
#   webhook URL  : ${NEXT_PUBLIC_APP_URL}/api/meta/leadgen
# ---------------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
# Any random string; echoed back during the webhook verification handshake.
META_VERIFY_TOKEN=

# OPTIONAL. Makes ad NAMES resolve on leads (otherwise only the ad id is stored).
# Reading an ad node needs the `ads_management` permission, which Facebook Login
# withholds until the app passes App Review — so the Page token is refused. A
# System User token needs no review and is used in preference to the Page token.
#   Business Settings -> Users -> System Users -> Add, then Generate New Token:
#   pick the Lead Ads app, tick ads_read (or ads_management), and give that system
#   user access to the ad account under Assign Assets. Tokens can be made to not expire.
# Unset, nothing breaks: leads simply keep showing the ad id.
META_ADS_TOKEN=

# ---------------------------------------------------------------------------------
# WhatsApp Embedded Signup — "Sirah CRM Wp" Meta app (separate from the Lead Ads app)
# App ID and Config ID are public (NEXT_PUBLIC_); App Secret is server-only.
#   App ID     : App Settings -> Basic -> App ID
#   Config ID  : Facebook Login for Business -> Configurations -> (your config) -> ID
#   App Secret : App Settings -> Basic -> App Secret (click Show)
# ---------------------------------------------------------------------------------
NEXT_PUBLIC_FB_APP_ID=
NEXT_PUBLIC_FB_CONFIG_ID=
FB_APP_SECRET=

# ---------------------------------------------------------------------------------
# Razorpay — Payment Collection (Payment Links API). Per-tenant credentials configured
# in-app under Settings -> Integrations take precedence; these are the shared fallback,
# used only when a tenant has not configured its own account.
#   Webhook URL (env fallback) : ${NEXT_PUBLIC_APP_URL}/api/payments/razorpay/webhook/env
#   Webhook URL (per-tenant)   : shown in-app once a tenant saves their own Key ID/secret
#   Subscribe the webhook to the "payment_link.paid" event only.
# ---------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
